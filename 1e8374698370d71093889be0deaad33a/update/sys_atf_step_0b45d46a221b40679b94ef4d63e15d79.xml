// ATF injects assertEqual, steps, outputs, stepResult and an enclosing try block - bare body.
var productId = "{{step['c732959cfa35446aa33434725cc69f73'].record_id}}";
var calc = new x_2298436_snackf_0.SnackFlowCalc();

// A downward correction is a deliberate manual decision (return / stock adjustment),
// so the rule must post nothing and leave the balance alone.
assertEqual({ name: 'balance unchanged by downward correction', shouldbe: 20, value: calc.ledgerBalance('finished_product', productId, null) });

var cnt = 0;
var g = new GlideRecord('x_2298436_snackf_0_stock_transaction');
g.addQuery('product', productId);
g.addQuery('remarks', 'STARTSWITH', 'Auto-posted by SnackFlow Dispatch Stock Posting');
g.query();
while (g.next()) cnt++;
assertEqual({ name: 'no extra auto-posted row for the downward correction', shouldbe: 1, value: cnt });

stepResult.setOutputMessage('after downward correction: pending=80 balance=20 auto_posted_rows=' + cnt);
</value>
