        <script><![CDATA[(function executeRule(current, previous) {
    var calc = new x_2298436_snackf_0.SnackFlowCalc()

    var purchaseOrderId = current.getValue('purchase_order')
    if (purchaseOrderId) {
        // Full re-sum of all lines of the order - never an increment.
        calc.recalcPurchaseOrder(purchaseOrderId)
    }

    // Re-parented line: recompute the order it was moved away from too.
    if (previous) {
        var previousPurchaseOrderId = previous.getValue('purchase_order')
        if (previousPurchaseOrderId && previousPurchaseOrderId !== purchaseOrderId) {
            calc.recalcPurchaseOrder(previousPurchaseOrderId)
        }
    }
})(current, previous)
]]></script>
