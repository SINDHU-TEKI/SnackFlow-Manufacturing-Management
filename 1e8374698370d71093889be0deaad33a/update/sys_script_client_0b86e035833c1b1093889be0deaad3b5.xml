        <messages/>
        <name>Calculate Invoice Total</name>
        <order/>
        <script><![CDATA[
function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) return;

    var taxable = parseFloat(g_form.getValue('taxable_amount')) || 0;
    var cgst = parseFloat(g_form.getValue('cgst_amount')) || 0;
    var sgst = parseFloat(g_form.getValue('sgst_amount')) || 0;
    var igst = parseFloat(g_form.getValue('igst_amount')) || 0;

    var total = taxable + cgst + sgst + igst;

    g_form.setValue('total_invoice_amount', total.toString());
}
]]></script>
