        <field>ordered_quantity</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Calculate Sales Line Amount</name>
        <order/>
        <script><![CDATA[
function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) {
        return;
    }

    var quantity = parseFloat(
        g_form.getValue('ordered_quantity')
    ) || 0;

    var price = parseFloat(
        g_form.getValue('unit_price')
    ) || 0;

    g_form.setValue(
        'line_amount',
        quantity * price
    );
}
]]></script>
