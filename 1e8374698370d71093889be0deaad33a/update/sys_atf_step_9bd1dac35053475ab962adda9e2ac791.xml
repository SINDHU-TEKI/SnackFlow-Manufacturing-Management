(function (outputs, steps, params, stepResult, assertEqual) {
    var productId = '{{step['c732959cfa35446aa33434725cc69f73'].record_id}}';
    var calc = new x_2298436_snackf_0.SnackFlowCalc();

    assertEqual({ name: 'balance 60 received minus 40 dispatched', shouldbe: 20, value: calc.ledgerBalance('finished_product', productId, null) });

    var posted = [];
    var g = new GlideRecord('x_2298436_snackf_0_stock_transaction');
    g.addQuery('product', productId);
    g.addQuery('remarks', 'STARTSWITH', 'Auto-posted by SnackFlow Dispatch Stock Posting');
    g.query();
    while (g.next()) posted.push(parseFloat(g.getValue('quantity')));

    assertEqual({ name: 'exactly one auto-posted dispatch row', shouldbe: 1, value: posted.length });
    assertEqual({ name: 'auto-posted quantity is the delta (40), not the running total', shouldbe: 40, value: posted[0] });

    stepResult.setOutputMessage('balance=20 auto_posted=[' + posted.join(',') + ']');
})(outputs, steps, params, stepResult, assertEqual);
</value>
