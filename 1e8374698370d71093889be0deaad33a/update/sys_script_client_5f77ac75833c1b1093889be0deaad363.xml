        <field>dispatched_quantity</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Calculate Pending Sales Quantity</name>
        <order/>
        <script><![CDATA[
function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) return;

    var ordered = parseFloat(g_form.getValue('ordered_quantity')) || 0;
    var dispatched = parseFloat(g_form.getValue('dispatched_quantity')) || 0;

    var pending = ordered - dispatched;

    if (pending < 0) {
        g_form.showFieldMsg(
            'dispatched_quantity',
            'Dispatched quantity cannot exceed ordered quantity.',
            'error'
        );
        return;
    }

    g_form.setValue('pending_quantity', pending);
}
]]></script>
