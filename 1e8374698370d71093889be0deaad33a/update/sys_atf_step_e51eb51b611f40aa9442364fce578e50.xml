(function (outputs, steps, params, stepResult, assertEqual) {
    var productId = '{{step['c732959cfa35446aa33434725cc69f73'].record_id}}';
    var calc = new x_2298436_snackf_0.SnackFlowCalc();

    // The whole point of moving the guard to a before-rule: the line save is refused,
    // so line and ledger cannot diverge.
    assertEqual({ name: 'ledger untouched by the refused dispatch', shouldbe: 20, value: calc.ledgerBalance('finished_product', productId, null) });

    var cnt = 0;
    var g = new GlideRecord('x_2298436_snackf_0_stock_transaction');
    g.addQuery('product', productId);
    g.addQuery('remarks', 'STARTSWITH', 'Auto-posted by SnackFlow Dispatch Stock Posting');
    g.query();
    while (g.next()) cnt++;
    assertEqual({ name: 'still only one auto-posted row after refusal', shouldbe: 1, value: cnt });

    stepResult.setOutputMessage('after refusal: balance=20 auto_posted_rows=' + cnt);
})(outputs, steps, params, stepResult, assertEqual);
</value>
